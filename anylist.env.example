# Copy to ~/.meal-planner/anylist.env (NOT into the project folder) and fill in.
# On Windows that path is C:\Users\<you>\.meal-planner\anylist.env
# Scripts read this file and never print its values.
ANYLIST_EMAIL=you@example.com
ANYLIST_PASSWORD=your-anylist-password
# Must exactly match a list that already exists in your AnyList app.
ANYLIST_LIST=Current Grocery List
